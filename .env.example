APP_NAME=RAG API
APP_VERSION=0.1.0
API_PREFIX=/api
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag
# Alternatively, omit DATABASE_URL and configure the connection in parts:
# DATABASE_HOST=your-render-host
# DATABASE_PORT=5432
# DATABASE_USER=your-render-user
# DATABASE_PASS=your-render-password
# DATABASE_NAME=your-render-database
# DB_SSL=true
CORS_ORIGINS=["http://localhost:5173","https://rag-front-jizp.onrender.com"]
OPENAI_API_KEY=your-openai-api-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
OPENAI_RESPONSE_MODEL=gpt-5.4-mini